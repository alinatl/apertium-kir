Sets

Vow = и ү е э ө а о у ы ;

!letter = ء ئ ا ە ب پ ت ج چ خ د ر ز ژ س ش غ ف ق ك گ ڭ ل م ن ھ و ۇ ۅ ۉ ۋ ى ي ;

backVow = а о ы у
          А О Ы У ;

frontVow = и ү е э ө
           И Ү Е Э Ө ;

Cons = б в г д ж з й к л м н ң п р с т ф х ц ч ш щ
       Б В Г Д Ж З Й К Л М Н Ң П Р С Т Ф Х Ц Ч Ш Щ ;

frontConsCyr = к г
               К Г ;

Nasal = Н М Ң
        н м ң ;

!frontLetter = ك گ ە ۅ ۉ ;

frontSound = k ɡ ɣ ŋ e i ø y ;

!backLetter = ق ع ا و ۇ ;

backSound = q ʁ ɢ ɴ ɑ ɯ o u ;

Rules

"%{й%}:j after vowels except е"
%{й%}:j <=> [ Vow: - [ э: | е: ] ]/%{ˈ%}: _ ;

"к г ң in the context of back vowels"
Cx:Cy <=> backVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) (Cons:*/%{ˈ%}:*) _ ; !барк, барг
          _ (Cons:*/%{ˈ%}:*) backVow:/%{ˈ%}: ; !гал, каб, краб, грал
      except
          ! _ (Cons:*/%{ˈ%}:*) backVow:/%{ˈ%}: ; !грал, краб
          !.#. а:/%{ˈ%}: _ (%{й%}:) е:/%{ˈ%}: ;  ! аке:ɑˈke
          !.#. б:/%{ˈ%}: (%{й%}:) е:/%{ˈ%}: _ а:/%{ˈ%}: ;  ! Бегайым:beɣɑjɯm
          Nasal:/%{ˈ%}: _ ;                                    !банк
          backVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ;  !багелек
          frontVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) (Cons:*/%{ˈ%}:*) _ ;       !милк
          _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ;         !крил
          !.#. _ (Cons:*/%{ˈ%}:*) Vow: ;         ! грил
!         ! .#. _ (Cons:*/%{ˈ%}:*) Vow: ;
          ! keep in mind if modifying this rule:
          ! - байке:bɑjke
          ! - багелек:bɑʁelek
      where Cx in ( к г ң )
            Cy in ( q ʁ ɴ )
      matched ;

!"клооп, класс, к перед задними гласными"
!к:q <=> _ (Cons:/%{ˈ%}:) backVow:/%{ˈ%}: ; !крап
!    except
!        _ Nasal:/%{ˈ%}: backVow:/%{ˈ%}: ; !кнап
!        Nasal:/%{ˈ%}: _ ;

"палатализация к перед передними гласными"
к:k <=> backVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ;
        frontVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) (Cons:*/%{ˈ%}:*) _ ;
        _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ; !крип
    except
        Nasal:/%{ˈ%}: _ ;
        Nasal:/%{ˈ%}: _ (Cons:*/%{ˈ%}:*) Vow: ;

"бегайым"
г:ɡ <=> frontVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ (Cons:*/%{ˈ%}:*) (%{й%}:) backVow:/%{ˈ%}: ;

"ɡ front"
г:ɡ <=> _ (%{й%}:) frontVow:/%{ˈ%}: ;
    backVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ;
    frontVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ; ! игрил
    _ (Cons:*/%{ˈ%}:*) (%{й%}:/%{ˈ%}:) frontVow:/%{ˈ%}: ; ! грил
    except
        Nasal:/%{ˈ%}: _ ;
        !.#. _ (Cons:*/%{ˈ%}:*) Vow: ;

!"кеттим:getˈtim"
!к:ɡ <=>  # :/%{ˈ%}: _ (%{й%}:) frontVow:/%{ˈ%}: ;

"г is a stop after nasals"
г:Cy <=> Vx: (%{t%}:*/%{ˈ%}:*) Cons:*/%{ˈ%}: Nasal:/%{ˈ%}: _ ;
         !.#. _ (Cons:*/%{ˈ%}:*) Vx: ;         ! грил
     where Vx in ( и ү е э ө а о у ы )
           Cy in ( ɡ ɡ ɡ ɡ ɡ ɢ ɢ ɢ ɢ )
     matched ;

"k is a stop after nasals"
к:Cy <=> Vx: (%{t%}:*/%{ˈ%}:*) (Cons:*/%{ˈ%}:*) Nasal:/%{ˈ%}: _ ;        ! танк
        !Nasal:/%{ˈ%}: _ ;
         !Nasal:/%{ˈ%}: _ (Cons:*/%{ˈ%}:*) Vx: ;
     where Vx in ( и ү е э ө а о у ы )
           Cy in ( k k k k k q q q q )
     matched ;

!"к and г in onset clusters (loanwords)"
!Cx:Cy <=> .#. (%{ˈ%}:) _ Cons:/%{ˈ%}: ;
!      where Cx in ( к г )
!            Cy in ( k ɡ )
!      matched ;

"stress on last syllable"
%{ˈ%}:ˈ <=>  _ Cons:/%{ˈ%}: Vow:/%{ˈ%}: (Vow:/%{ˈ%}:) Cons:*/%{ˈ%}: .#. ;
            .#. _ Cons:*/%{ˈ%}: Vow:/%{ˈ%}: (Vow:/%{ˈ%}:) Cons:/%{ˈ%}:* .#. ;
        except
            .#. Cons:/%{ˈ%}: Cons:*/%{ˈ%}: _ ;


"б as β"
б:β <=> Vow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ Vow:/%{ˈ%}: ;

"dark ɫ"
л:ɫ <=> backVow:/%{ˈ%}: (%{t%}:*/%{ˈ%}:*) _ ;
        _ backVow:/%{ˈ%}: ;
    except
        :j (%{ˈ%}:) _ ;
        _ ь: ;

"second of long vowel as ː"
Vx:ː <=> Vy:/%{ˈ%}: _ ;
     where Vy in ( ү э ө а о у )
           Vx in ( ү э ө а о у )
     matched ;

"ж as ʒ only after д"
ж:ʒ <=> д:/%{ˈ%}: _ ;

"з as s near voiceless с (full assimilation)"
з:s <=> _ с:/%{ˈ%}: ;

